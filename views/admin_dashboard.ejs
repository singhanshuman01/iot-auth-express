        .error-message {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
            display: none;
        }

        .error-message.show {
            display: block;
        }
    </style>

    <title>Admin Dashboard</title>
</head>

<body>
    <h1>Dashboard</h1>

    <div id="temporary-banner" class="banner-hidden">
        <div id="progress-bar"></div>
        <p>
            <%= msg %>
        </p>
    </div>

    <div class="container">
        <div class="charging-status">
            <% for( let i=0; i < relayStatus.length; i++ ) { %>
                <% if (relayStatus[i]=="on") { %>
                    <div id="relay-info-<%= i %>">
                        <p>Port <%= i+1 %> is active</p>
                        <form action="/admin/terminate-session" method="post">
                            <input type="number" name="uid" value="<%= relayStatus[i].uid %>" hidden="">
                            <input type="number" name="relaynum" value="<%= i %>" hidden="">
                            <button type="submit" style="color: red;">x</button>
                        </form>
                    </div>

                    <% }else{ %>
                        <div id="relay-info-<%= i %>">
                            <p>Port <%= i+1 %> is inactive</p>
                        </div>
                        <% } %>
                            <% } %>
        </div>
        <form action="/admin/create-user" method="post" id="createUserForm">
            <label for="username">Username</label>
            <input type="text" name="username" id="username" required placeholder="Username">

            <label for="passwd">Password</label>
            <input type="password" name="password" id="passwd" required placeholder="Password">

            <div class="button-group">
                <input type="submit" value="Create new user">
                <input type="reset" value="Reset">
            </div>

        </form>

        <form id="deleteUserForm">
            <label for="del-username">Username to Delete:</label>
            <input type="text" id="del-username" name="username" required placeholder="Enter username">
            
            <label for="adminPassword">Admin Password:</label>
            <input type="password" id="adminPassword" name="adminPassword" required placeholder="Enter your password">
            <div class="error-message" id="errorMessage"></div>
            

            <div class="button-group">
                <input type="submit" value="Delete User">
                <input type="reset" value="Clear">
            </div>
            <div id="customPrompt" style="display: none;">
                <div id="promptDialog">
                    <p>Input password again:</p>
                    <input type="password" id="promptPass"> <br>
                    <button type="button" id="confirmBtn">Confirm</button>
                    <button type="button" id="cancelBtn">Cancel</button>
                </div>
            </div>
        </form>
        

        <div class="logs">
            <table>
                <thead>
                    <th>Sr.no</th>
                    <th>User Name</th>
                    <th>Time Period</th>
                    <th>Time Stamp</th>
                    <th>Bill</th>
                </thead>
                <tbody>
                    <% for(let i=0; i < logs.length; i++) { %>
                        <tr>
                            <td>
                                <%= i+1 %>
                            </td>
                            <td>
                                <%= logs[i].username %>
                            </td>
                            <td>
                                <%= logs[i].time_period %>
                            </td>
                            <td>
                                <%= logs[i].time_stamp %>
                            </td>
                            <td>
                                <%= logs[i].time_period*5 %>
                            </td>
                        </tr>
                        <% } %>

                </tbody>
            </table>
        </div>



    </div>
    <form action="/admin/logout" method="post">

        <button type="submit" class="logout-btn">Logout</button>
    </form>


    <script src="/socket.io/socket.io.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const isCreated = params?.get("user") || null;
        if (isCreated === "created") {
            document.addEventListener("DOMContentLoaded", bannerHolder);
        }
        function bannerHolder() {
            const banner = document.getElementById("temporary-banner");
            const progressBar = document.getElementById("progress-bar");
            const displayTime = 5000;
            banner.classList.remove('banner-hidden');
            banner.classList.add('banner-visible');
            progressBar.classList.add("animate-progress-bar");

            setTimeout(() => {
                banner.classList.remove("banner-visible");
                progressBar.classList.remove("animate-progress-bar");

                setTimeout(() => {
                    banner.classList.add("banner-hidden")
                }, 500);
            }, displayTime);
        }
    </script>
    <script>
        const socket = io();
        socket.on('relay-busy', (relay, uid)=>{
            const maindiv = document.getElementById(`relay-info-${relay}`);
            maindiv.innerHTML = `<p>Port ${relay+1} is active</p>
                        <form action="/admin/terminate-session" method="post">
                            <input type="number" name="uid" value="${uid}" hidden="">
                            <input type="number" name="relaynum" value="${relay}" hidden>
                            <button type="submit" style="color: red;">x</button>
                        </form>`;
        });

        socket.on("relay-free", relay=>{
            const maindiv = document.getElementById(`relay-info-${relay}`);
            maindiv.innerHTML = `<p>Port ${relay+1} is inactive</p>`;
        })
    </script>

    <script>
        const deleteUserForm = document.getElementById('deleteUserForm');
        const errorMessage = document.getElementById('errorMessage');

        deleteUserForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorMessage.classList.remove('show');

            const username = document.getElementById('del-username').value.trim();
            const adminPassword = document.getElementById('adminPassword').value;

            if (!username || !adminPassword) {
                showError('Please fill in all fields');
                return;
            }

            // First confirmation: Reconfirm password
            const promptOverlay = document.getElementById("customPrompt");
            promptOverlay.style.display = "flex";


            let reconfirmPassword = null;
            document.getElementById("confirmBtn").addEventListener("click", async ()=>{
                reconfirmPassword = document.getElementById("promptPass").value;

                if (reconfirmPassword === null) {
                    // User clicked cancel
                    console.log("reconfirm password is null");
                    return;
                }

                if (reconfirmPassword !== adminPassword) {
                    promptOverlay.style.display = "none";
                    showError('Password does not match. Operation cancelled.');
                    return;
                }

                console.log("reconfirm password equals password");

                // Second confirmation: Warning prompt
                const finalConfirm = confirm(`⚠️  WARNING ⚠️\n\nYou are about to permanently delete the user: "${username}"\n\nThis action CANNOT be undone.\n\nAre you sure you want to proceed?`);

                if (!finalConfirm) {
                    // User clicked cancel
                    return;
                }
                document.getElementById("promptPass").value = "";
                promptOverlay.style.display = "none";
                // All confirmations passed, proceed with deletion
                try {
                    const response = await fetch('/admin/delete-user', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            username: username,
                            adminPassword: adminPassword
                        })
                    });

                    const data = await response.json();

                    if (response.ok) {
                        alert(`✓ User "${username}" has been successfully deleted.`);
                        deleteUserForm.reset();
                    } else {
                        showError(data.message || 'Failed to delete user');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showError('An error occurred while trying to delete the user');
                }
            });
            document.getElementById("cancelBtn").addEventListener("click", ()=>{
                promptOverlay.style.display = "none";
            });
                                    
        });

        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.classList.add('show');
        }
    </script>

</body>

</html>